          "conditions": [
            {
              "id": "publish",
              "leftValue": "={{ $json.publish }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
