    {
      "name": "Wait for generation",
      "id": "wait-for-generation",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        900,
        1100
      ],
      "parameters": {
        "resume": "timeInterval",
