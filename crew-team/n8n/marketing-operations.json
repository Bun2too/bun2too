        0
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.failed) {\n  throw new Error((result.reason || \"Marketing operation failed\") + \"; runs=\" + (result.run_ids || []).join(\",\"));\n}\nreturn $input.all();"
      }
