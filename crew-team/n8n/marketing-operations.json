    {
      "id": "read-daily-campaign",
      "name": "Read daily campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "url": "={{ '__CREWAI_BASE_URL__/runs/' + $('Generate daily campaign').first().json.run_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__MARKETING_CREDENTIAL_ID__",
          "name": "Marketing API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Plan daily continuation",
      "id": "plan-daily-continuation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        1300
      ],
      "parameters": {
        "jsCode": "const run = $input.first().json;\nconst id = run.id || run.run_id;\nconst expected = $('Generate daily campaign').first().json.run_id;\nif (!id || id !== expected) throw new Error('Daily campaign identity mismatch');\nconst now = Date.now();\nconst deadline = Date.parse(run.publish_before);\nif (!Number.isFinite(deadline) || now >= deadline) throw new Error('Daily campaign publishing window expired; runs=' + id);\nif (run.status === 'published') return [{json: {pending: false, publish: false, run_id: id}}];\nif (run.status === 'approved') {\n  const target = Date.parse(run.publish_after);\n  if (!Number.isFinite(target) || target >= deadline) throw new Error('Invalid publication time; runs=' + id);\n  return [{json: {pending: false, publish: true, run_id: id, publish_at: new Date(Math.max(now, target)).toISOString()}}];\n}\nif (['queued', 'running'].includes(run.status) || (run.status === 'failed' && run.retryable)) {\n  if ($runIndex >= 5 || now + 15 * 60 * 1000 >= deadline) throw new Error('Daily generation wait exhausted (maximum six checks); inspect campaign before manual recovery; runs=' + id);\n  return [{json: {pending: true, publish: false, run_id: id}}];\n}\nthrow new Error('Campaign requires intervention: ' + run.status + '; runs=' + id);\n"
      }
    },
    {
      "name": "Generation still pending",
      "id": "generation-still-pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        1400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "pending",
              "leftValue": "={{ $json.pending }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
