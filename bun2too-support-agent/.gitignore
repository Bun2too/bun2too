# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.python-version

# Python packaging and build output (keep dependency lockfiles tracked)
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test, lint, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template
.secrets/

# CrewAI local runtime data and logs
# Keep agent definitions, campaign content, and design assets tracked.
.crewai/
.data/
.chroma/
chroma.sqlite3*
*.log
logs/

# Terraform provider downloads, local state, saved plans, and overrides
# Commit .terraform.lock.hcl for reproducible CI deployments.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform variable values may contain secrets; commit templates instead.
*.tfvars
*.tfvars.json

# Editor temporary files and operating-system metadata
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
#*.example
# Share the repository context requested for coding agents, even with a global ignore.
!AGENTS.md
!**/AGENTS.md

# Synthetic CI evaluation evidence (visible model completions/review records).
/artifacts/agent-evals/

# Node / TypeScript
node_modules/
*.tsbuildinfo
.turbo/

# Relay verification evidence and local runtime
.verify/
.langgraph_api/
