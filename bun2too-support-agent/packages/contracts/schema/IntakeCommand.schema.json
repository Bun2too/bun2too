{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,40}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "intake": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "web_widget",
            "a2a",
            "email",
            "marketplace",
            "retail"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "customer": {
          "default": {},
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "locale": {
              "type": "string",
              "minLength": 2,
              "maxLength": 35
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "required": [
        "channel",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tenant",
    "idempotencyKey",
    "intake"
  ],
  "additionalProperties": false
}
