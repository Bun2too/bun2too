{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay Support Intake API",
    "version": "0.1.0",
    "description": "Hand Relay a customer problem and get a tracked support case. Relay classifies it, opens one Jira issue and one ServiceNow record, then resolves it, asks the customer one question, or escalates it to a person. Status values settle at `resolved`, `awaiting_customer`, `escalated` or `rejected`. Agents can use the same flow over A2A (`/.well-known/agent-card.json`, `POST /a2a`)."
  },
  "servers": [
    {
      "url": "http://localhost:8787"
    }
  ],
  "security": [
    {
      "apiKey": []
    },
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "cases",
      "description": "Open and follow support cases"
    },
    {
      "name": "meta",
      "description": "Health, discovery and this document"
    }
  ],
  "paths": {
    "/v1/intake": {
      "post": {
        "tags": [
          "cases"
        ],
        "operationId": "createIntake",
        "summary": "Open a support case",
        "description": "Opens a case and starts the agents in the background. The same `Idempotency-Key` always returns the same case (200, `created: false`) and never opens a second set of tickets.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique per customer submission, at most 200 characters. Reuse it when retrying.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retry of an earlier intake; the existing case",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeAccepted"
                }
              }
            }
          },
          "202": {
            "description": "Case opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeAccepted"
                }
              }
            }
          },
          "400": {
            "description": "`idempotency_key_required`: header missing or longer than 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`: missing or unknown tenant key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_intake`: the body failed validation; see `issues`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "`agents_unavailable`: try again with the same Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}": {
      "get": {
        "tags": [
          "cases"
        ],
        "operationId": "getCase",
        "summary": "Get a case",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The case ID returned by `POST /v1/intake`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The case",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Case"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such case for this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}/messages": {
      "post": {
        "tags": [
          "cases"
        ],
        "operationId": "replyToCase",
        "summary": "Answer the case's pending question",
        "description": "Only when the case is `awaiting_customer`. The agents resume the same case and tickets.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The case ID returned by `POST /v1/intake`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerReply"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Reply accepted; the case resumes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Case"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`not_awaiting_customer`: the case is not waiting for a reply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_reply`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}/events": {
      "get": {
        "tags": [
          "cases"
        ],
        "operationId": "streamCaseEvents",
        "summary": "Stream the case's events (Server-Sent Events)",
        "description": "Sends every `CaseEvent` as an SSE message named `case_event` whose data is the event JSON and whose id is its `seq`. The stream ends after a settled status or after 120 seconds; reconnect or poll `GET /v1/cases/{id}` to continue.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The case ID returned by `POST /v1/intake`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/CaseEvent"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/a2a": {
      "post": {
        "tags": [
          "cases"
        ],
        "operationId": "a2aRpc",
        "summary": "A2A JSON-RPC 2.0 endpoint (protocol 0.3.0)",
        "description": "Methods: `message/send` (opens a case, or answers one when `message.taskId` is set) and `tasks/get`. A task's `id` is the case ID. `metadata.relayStatus` and `metadata.tickets` carry Relay's status and ticket links. Errors use JSON-RPC error objects with HTTP 200.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "id",
                  "method",
                  "params"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "method": {
                    "enum": [
                      "message/send",
                      "tasks/get"
                    ]
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON-RPC response"
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "health",
        "summary": "Liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "`{ ok: true, service, offline }`"
          }
        }
      }
    },
    "/.well-known/agent-card.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "agentCard",
        "summary": "A2A agent card",
        "security": [],
        "responses": {
          "200": {
            "description": "The A2A agent card"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "openApi",
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "A tenant key issued by the Relay operator. Server-side only."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same tenant key."
      }
    },
    "schemas": {
      "IntakeRequest": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "web_widget",
              "a2a",
              "email",
              "marketplace",
              "retail"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "customer": {
            "default": {},
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "locale": {
                "type": "string",
                "minLength": 2,
                "maxLength": 35
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "required": [
          "channel",
          "message"
        ],
        "additionalProperties": false
      },
      "IntakeAccepted": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "triaged",
              "ticketed",
              "in_progress",
              "awaiting_customer",
              "escalated",
              "resolved",
              "rejected"
            ]
          },
          "traceId": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": [
          "caseId",
          "status",
          "traceId",
          "created"
        ],
        "additionalProperties": false
      },
      "CustomerReply": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "Case": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "triaged",
              "ticketed",
              "in_progress",
              "awaiting_customer",
              "escalated",
              "resolved",
              "rejected"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "web_widget",
              "a2a",
              "email",
              "marketplace",
              "retail"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "traceId": {
            "type": "string"
          },
          "classification": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string",
                    "enum": [
                      "knowledge",
                      "identity",
                      "integration",
                      "commerce",
                      "privacy",
                      "other"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "sev1",
                      "sev2",
                      "sev3",
                      "sev4"
                    ]
                  },
                  "sentiment": {
                    "type": "string",
                    "enum": [
                      "negative",
                      "neutral",
                      "positive"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  }
                },
                "required": [
                  "intent",
                  "severity",
                  "sentiment",
                  "summary",
                  "language"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "tickets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "system": {
                  "type": "string",
                  "enum": [
                    "jira",
                    "servicenow"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "system",
                "key",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "resolution": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "auto_resolved",
                      "escalated",
                      "rejected"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "kind",
                  "message",
                  "citations"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "pendingQuestion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "tenant",
          "status",
          "channel",
          "createdAt",
          "updatedAt",
          "traceId",
          "classification",
          "tickets",
          "resolution",
          "pendingQuestion"
        ],
        "additionalProperties": false
      },
      "CaseEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "caseId": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "triaged",
              "ticketed",
              "in_progress",
              "awaiting_customer",
              "escalated",
              "resolved",
              "rejected"
            ]
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "seq",
          "caseId",
          "at",
          "status",
          "actor",
          "reason",
          "data"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable error code, for example `unauthorized`."
          },
          "issues": {
            "description": "Validation issues, on 422 only.",
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
