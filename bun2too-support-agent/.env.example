# Copy to .env.local. Never commit real values.
RELAY_OFFLINE=1
RELAY_GATEWAY_PORT=8787
RELAY_AGENTS_URL=http://localhost:8000
RELAY_TENANT_KEYS=dev-bun2too-key:bun2too
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=relay

# Model provider (used when RELAY_OFFLINE is unset)
ANTHROPIC_API_KEY=
# Cloudflare AI Gateway (ADR 0007). Leave both IDs empty to call the provider directly.
CF_AIG_ACCOUNT_ID=
CF_AIG_GATEWAY_ID=
CF_AIG_TOKEN=

# Systems of record (referenced by tenants/*.yaml *_env fields)
BUN2TOO_JIRA_BASE_URL=
BUN2TOO_JIRA_EMAIL=
BUN2TOO_JIRA_API_TOKEN=
BUN2TOO_SNOW_INSTANCE_URL=
BUN2TOO_SNOW_USER=
BUN2TOO_SNOW_PASSWORD=

DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
