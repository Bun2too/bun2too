# Copy to crewai_agents/.env locally. In Railway use service Variables instead.
# Generate a long random API key; callers send Authorization: Bearer <key>.
MARKETING_API_KEY=
LLM_MODEL=openai/gpt-4o
OPENAI_API_KEY=
# Other providers require their own API keys and CrewAI provider dependencies.
AGENT_VERBOSE=false
CREWAI_TRACING_ENABLED=false
# Railway: mount a persistent volume at /data and set DATA_DIR=/data.
# DATA_DIR=/data

# Configure n8n before enabling this. Dispatch can trigger actual publishing.
PUBLISHING_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
# Legacy webhook dispatch is optional. The scheduled publisher uses FACEBOOK_* below; never put tokens in agent prompts.

# Datadog Agent Observability. Enable after adding the API key as a secret.
# Use python crewai_agents/start.py so these load before ddtrace-run starts.
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ENABLED=0
DD_LLMOBS_ML_APP=bun2too-marketing-crew-team
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_API_KEY=
DD_ENV=qa
DD_SERVICE=bun2too-marketing-api
DD_TRACE_ENABLED=false

# Dedicated Atlassian bot account: Jira CMA and Confluence Cloud CMA.
# Use the canonical Cloud API origin; the custom domain is used for page links.
ATLASSIAN_BASE_URL=https://bun2too.atlassian.net
CONFLUENCE_BASE_URL=https://bun2too.atlassian.net
CONFLUENCE_WEB_URL=https://wiki.doc.bun2too.com
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=CMA
CONFLUENCE_SPACE_KEY=CMA
# Optional numeric space ID bypasses lookup by key.
CONFLUENCE_SPACE_ID=
# Optional parent page for all campaign dossiers.
CONFLUENCE_PARENT_ID=
# Set only if your Jira Epic create screen requires a custom Epic Name field.
JIRA_EPIC_NAME_FIELD=
ATLASSIAN_AUTO_PUBLISH=true
ATLASSIAN_MAX_WORK_ITEMS=12
ATLASSIAN_MAX_NEW_CAMPAIGNS_PER_DAY=3

# Scheduled marketing. Complete config/marketing.json before enabling.
MARKETING_AUTOMATION_ENABLED=false
AUTO_APPROVAL_ENABLED=false
WORKER_ENABLED=true
# Optional absolute override. Defaults to the packaged config/marketing.json locally and in Docker.
# MARKETING_PROFILE_PATH=/absolute/path/to/marketing.json
PUBLIC_API_BASE_URL=
FACEBOOK_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
DD_LOGS_ENABLED=false
